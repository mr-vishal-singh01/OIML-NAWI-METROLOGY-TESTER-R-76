{
  "name": "sih26035-metrology-workbench",
  "version": "2.0.0",
  "description": "Automated OIML R-76 Guided NAWI Testing Suite & Traceable Archival System",
  "main": "main.js",
  "author": "SIH26035 PrecisionX Metrology Team (Ministry of Consumer Affairs, Govt. of India)",
  "license": "Proprietary",
  "scripts": {
    "start": "electron . --no-sandbox",
    "start:win": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:pi": "electron-builder --linux deb --arm64",
    "build:all": "electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "gov.in.sih26035.metrology",
    "productName": "Legal Metrology Workbench",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
